# Server-only. The browser never talks to the API directly: every call goes through
# this app's /api routes (BFF), which hold the tokens in HttpOnly cookies.
HSF_API_BASE_URL=https://hsf-api-v1.onrender.com

# Optional product analytics. Leave the public project key blank to disable it.
# Set these before building the web app. Never use a PostHog personal API key here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU projects: https://eu.i.posthog.com

# Optional server operational logs (method/status only), independent of browser analytics.
POSTHOG_LOGS_ENABLED=0
