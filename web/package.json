{
  "name": "hsf-web",
  "version": "0.1.0",
  "private": true,
  "description": "HSF Web v2: Next.js frontend over the HSF API (P1-58). Current web UI at app.hsfinest.com.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/sentry-sourcemaps.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript openapi.json -o src/api/schema.d.ts && git diff --exit-code -- src/api/schema.d.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@tanstack/react-table": "9.2.4",
    "lightweight-charts": "^5.2.1",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "posthog-js": "^1.438.13",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@sentry/cli": "3.8.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
