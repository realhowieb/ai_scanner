# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to version control.
#
# Three separate secret stores: Streamlit Cloud (this file's keys, in the app's
# Secrets settings), GitHub Actions (repository secrets for scheduled jobs) and
# Render (billing service environment). A key set in one is not seen by the others.

# --- Database ---
[neon]
database_url = "postgresql://user:password@host/dbname?sslmode=require"

# --- Admin users ---
# Comma-separated usernames that are granted admin access.
# These must also have is_admin=TRUE in the users table (set via grant_admin()).
# Leave empty to rely entirely on the DB is_admin flag.
ADMIN_USERS = ""

# --- Sign-in cookies and encryption ---
# COOKIE_PASSWORD encrypts the sign-in cookie. Long and random; changing it signs everyone out.
COOKIE_PASSWORD = ""
# Encrypts stored per-user Alpaca paper-trading keys. Falls back to COOKIE_PASSWORD
# if unset. Once keys are stored, changing it makes them unreadable (users re-enter them).
APP_ENCRYPTION_KEY = ""

# --- Stripe ---
STRIPE_SECRET_KEY = "sk_live_..."
STRIPE_WEBHOOK_SECRET = "whsec_..."
STRIPE_PRICE_PRO = "price_..."
STRIPE_PRICE_PREMIUM = "price_..."

# --- App URLs (for billing redirects and email links) ---
APP_BASE_URL = "https://your-app.streamlit.app"
APP_SUCCESS_URL = "https://your-app.streamlit.app"
APP_CANCEL_URL = "https://your-app.streamlit.app"
APP_PORTAL_RETURN_URL = "https://your-app.streamlit.app/billing"

# --- Market data (Alpaca) ---
ALPACA_API_KEY_ID = ""
ALPACA_API_SECRET_KEY = ""

# --- AI scan summary (Anthropic, Premium) ---
ANTHROPIC_API_KEY = "sk-ant-..."
# Optional. Defaults to the model set in config.py.
# ANTHROPIC_MODEL = ""
# Kill switch: "0" turns every AI feature off at once.
# AI_ENABLED = "1"
# Per-user AI calls per rolling 24h (0 = unlimited).
# AI_DAILY_LIMIT = "25"

# --- Email (Resend over SMTP) ---
# Verification, password reset, digests and alerts. Use a Resend API key with
# "Sending access" only (not "Full access"): it can send but can't read or change
# the account. The sender must be on a domain verified in Resend.
SMTP_HOST = "smtp.resend.com"
SMTP_PORT = "587"
SMTP_USER = "resend"
SMTP_PASS = "re_..."
SMTP_FROM = "alerts@ai.hsfinest.com"
# Inbox display name (default "HSF Alerts").
# SMTP_FROM_NAME = "HSF Alerts"

# --- Error reporting (optional) ---
# SENTRY_DSN = ""

# --- Demo users (DISABLE IN PRODUCTION) ---
# ENABLE_DEMO_USERS = "0"
# DEMO_BASIC_PASSWORD = ""
# DEMO_PRO_PASSWORD = ""
# DEMO_PREMIUM_PASSWORD = ""
# DEMO_ADMIN_PASSWORD = ""
