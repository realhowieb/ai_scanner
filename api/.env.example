# Optional integrations. Set these in the Python API service environment.
# Other API/database/auth variables are documented in docs/API.md.
# Public PostHog project key only, never a personal API key.
POSTHOG_AI_ENABLED=0
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Existing error reporting (disabled without a DSN).
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_RELEASE=

# Existing browser push: reuse production keys; never rotate as part of setup.
HSF_WEB_PUSH_ENABLED=0
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
